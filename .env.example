# Application connection string (local Postgres in development)
DATABASE_URL=postgres://user:password@localhost:5432/cpq_demo

# Public base URL, used to build absolute links (sharing metadata's preview
# image). Defaults to localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres container credentials (docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cpq_demo
